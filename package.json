{
  "name": "@ai3drenderlab/architectural-prompt-kit",
  "version": "0.2.0",
  "description": "A dependency-free toolkit for validating and assembling structured architectural visualization prompts.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "apk": "./bin/apk.js"
  },
  "files": [
    "bin/",
    "src/",
    "schema/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "check:example": "node bin/apk.js examples/tropical-residence.json"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kowshikprasad/architectural-prompt-kit.git"
  },
  "keywords": [
    "architecture",
    "architectural-visualization",
    "prompt-engineering",
    "ai-rendering",
    "3d"
  ]
}